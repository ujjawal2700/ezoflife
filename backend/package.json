{
  "name": "backend",
  "version": "1.0.0",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed-services": "node scratch/seed_vendor_services.js",
    "test": "npm run test:unit && npm run test:api",
    "test:unit": "node --test --test-reporter=spec tests/unit/*.test.js",
    "test:api": "node --test --test-reporter=spec --test-timeout=120000 --test-concurrency=1 tests/api/*.test.js",
    "test:watch": "node --test --watch tests/unit/*.test.js",
    "test:load": "node tests/load/loadTest.js --scenario load",
    "test:load:write": "node tests/load/loadTest.js --scenario write",
    "test:volume": "node tests/load/loadTest.js --scenario volume --orders 1500",
    "test:perf": "node tests/load/loadTest.js --scenario all",
    "test:stress": "node tests/load/loadTest.js --scenario stress"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "axios": "^1.14.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^1.41.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "firebase-admin": "^13.8.0",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.18.1",
    "mongoose": "^8.4.1",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "multer-storage-cloudinary": "^4.0.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.7",
    "pdfkit": "^0.18.0",
    "razorpay": "^2.9.6",
    "socket.io": "^4.8.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.2",
    "supertest": "^7.2.2"
  }
}
